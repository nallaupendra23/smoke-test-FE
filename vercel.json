{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://YOUR_BACKEND_URL/api/auth/:path*"
    },
    {
      "source": "/api/restaurant/:path*",
      "destination": "https://YOUR_BACKEND_URL/api/restaurant/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_BACKEND_URL/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
